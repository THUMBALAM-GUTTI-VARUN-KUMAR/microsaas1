---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="max-w-4xl mx-auto py-16 px-6 text-[var(--text-body)] space-y-8 leading-relaxed">
  <div class="space-y-6">
    <h2 class="text-3xl font-semibold text-[var(--text-ink)] mb-4">{t('seo.h1')}</h2>
    <p set:html={t('seo.p1')}></p>
    <p set:html={t('seo.p2')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h2')}</h3>
    <p set:html={t('seo.p3')}></p>
    <p set:html={t('seo.p4')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h3')}</h3>
    <p set:html={t('seo.p5')}></p>
    <p set:html={t('seo.p6')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h4')}</h3>
    <p set:html={t('seo.p7')}></p>
    <p set:html={t('seo.p8')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h5')}</h3>
    <p set:html={t('seo.p9')}></p>
    <ul class="list-disc pl-6 space-y-2 mt-4">
      <li><strong>{t('seo.s1')}</strong> {t('seo.s1d')}</li>
      <li><strong>{t('seo.s2')}</strong> {t('seo.s2d')}</li>
      <li><strong>{t('seo.s3')}</strong> {t('seo.s3d')}</li>
      <li><strong>{t('seo.s4')}</strong> {t('seo.s4d')}</li>
      <li><strong>{t('seo.s5')}</strong> {t('seo.s5d')}</li>
    </ul>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h6')}</h3>
    <p set:html={t('seo.p10')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h7')}</h3>
    <p set:html={t('seo.p11')}></p>

    <h3 class="text-2xl font-semibold text-[var(--text-ink)] mt-8 mb-4">{t('seo.h8')}</h3>
    <p set:html={t('seo.p12')}></p>
  </div>
</section>
