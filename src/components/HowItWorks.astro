---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const steps = [
  {
    step: "01",
    title: t('hiw.1.title'),
    description: t('hiw.1.desc'),
    icon: `<svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`
  },
  {
    step: "02",
    title: t('hiw.2.title'),
    description: t('hiw.2.desc'),
    icon: `<svg class="w-5 h-5 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  },
  {
    step: "03",
    title: t('hiw.3.title'),
    description: t('hiw.3.desc'),
    icon: `<svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>`
  }
];
---

<section class="py-16 px-4 sm:px-6 max-w-6xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="tech-badge px-3 py-1 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface-secondary)] text-[var(--text-mute)] text-xs font-semibold">
      {t('hiw.badge')}
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-ink)] mt-3 mb-2">
      {t('hiw.title')}
    </h2>
    <p class="text-xs sm:text-sm text-[var(--text-body)]">
      {t('hiw.desc')}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
    {steps.map((item) => (
      <div class="relative p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-[var(--bg-surface-secondary)] border border-[var(--border-color)] flex items-center justify-center" set:html={item.icon} />
            <span class="font-mono font-extrabold text-2xl text-[var(--text-mute)]/40">
              {item.step}
            </span>
          </div>
          <h3 class="text-base font-bold text-[var(--text-ink)] mb-2">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-body)] leading-relaxed">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
