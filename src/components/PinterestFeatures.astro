---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const features = [
  {
    title: t('feat.1.title'),
    description: t('feat.1.desc'),
    badge: "MP4 Video",
    icon: `<svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`,
    link: "/video-downloader"
  },
  {
    title: t('feat.2.title'),
    description: t('feat.2.desc'),
    badge: "High-Res Image",
    icon: `<svg class="w-5 h-5 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    link: "/image-downloader"
  },
  {
    title: t('feat.3.title'),
    description: t('feat.3.desc'),
    badge: "Animated GIF",
    icon: `<svg class="w-5 h-5 text-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    link: "/gif-downloader"
  },
  {
    title: t('feat.4.title'),
    description: t('feat.4.desc'),
    badge: "MP3 Audio",
    icon: `<svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
    link: "/audio-extractor"
  },
  {
    title: t('feat.5.title'),
    description: t('feat.5.desc'),
    badge: "Carousels",
    icon: `<svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
    link: "/"
  },
  {
    title: t('feat.6.title'),
    description: t('feat.6.desc'),
    badge: "500 MB Limit",
    icon: `<svg class="w-5 h-5 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    link: "/pricing"
  }
];
---

<section class="py-16 px-4 sm:px-6 max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-ink)] mb-3">
      {t('feat.title')}
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-body)]">
      {t('feat.desc')}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {features.map((feat) => (
      <a 
        href={feat.link} 
        class="group p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] hover:border-neutral-400 dark:hover:border-neutral-600 transition-all hover:shadow-md flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-[var(--bg-surface-secondary)] border border-[var(--border-color)] flex items-center justify-center group-hover:scale-105 transition-transform" set:html={feat.icon} />
            <span class="tech-badge px-2 py-0.5 rounded-full bg-[var(--bg-surface-secondary)] text-[var(--text-mute)] border border-[var(--border-color)] text-[10px]">
              {feat.badge}
            </span>
          </div>
          <h3 class="text-base font-semibold text-[var(--text-ink)] mb-1.5 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            {feat.title}
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-body)] leading-relaxed">
            {feat.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[var(--border-color)] flex items-center text-xs font-medium text-[var(--text-mute)] group-hover:text-[var(--text-ink)] transition-colors">
          <span>{t('feat.explore')}</span>
          <svg class="w-3.5 h-3.5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
