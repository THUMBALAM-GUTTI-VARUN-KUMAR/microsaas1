---
// MediaResultCard Component
---

<div id="result-container" class="hidden mt-8 w-full max-w-3xl mx-auto">
  <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5 sm:p-7 shadow-lg transition-all">
    <!-- Header: Status & Pin ID -->
    <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-4 mb-5">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </span>
        <span class="text-sm font-semibold text-[var(--text-ink)]">Original Media Extracted</span>
      </div>
      <span id="result-pin-id" class="tech-badge px-2 py-0.5 rounded bg-[var(--bg-surface-secondary)] text-[var(--text-mute)] border border-[var(--border-color)] text-xs">
        PIN #
      </span>
    </div>

    <!-- Media Content Body -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
      <!-- Media Preview Column (5 cols) -->
      <div class="md:col-span-5 flex flex-col items-center">
        <div id="media-preview-wrapper" class="relative w-full min-h-[280px] max-h-[450px] bg-neutral-950 rounded-xl overflow-hidden shadow-inner flex items-center justify-center border border-[var(--border-color)]">
          <!-- Image Preview with no-referrer -->
          <img 
            id="result-image-preview" 
            src="" 
            alt="Pinterest Original Media Preview" 
            referrerpolicy="no-referrer"
            class="hidden w-full h-auto max-h-[450px] object-contain rounded-lg transition-opacity duration-300"
            loading="eager"
          />
          <!-- Video Preview Player -->
          <video 
            id="result-video-preview" 
            controls 
            playsinline 
            preload="metadata"
            class="hidden w-full h-auto max-h-[450px] object-contain"
          ></video>
          <!-- Audio Waveform Placeholder -->
          <div id="result-audio-preview" class="hidden flex flex-col items-center justify-center p-6 text-center text-white">
            <div class="w-16 h-16 rounded-full bg-blue-600/30 flex items-center justify-center mb-3">
              <svg class="w-8 h-8 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-neutral-400">Audio Extracted (MP3)</span>
          </div>
        </div>

        <div class="flex items-center justify-between w-full mt-2.5 px-1 text-xs text-[var(--text-mute)]">
          <p id="result-author" class="truncate max-w-[180px]">
            By: <span class="font-medium text-[var(--text-body)]">Pinterest User</span>
          </p>
          <a 
            id="btn-open-original" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            referrerpolicy="no-referrer"
            class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
          >
            <span>View Full Size</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Details & Formats Column (7 cols) -->
      <div class="md:col-span-7 flex flex-col justify-between h-full space-y-4">
        <div>
          <h3 id="result-title" class="text-lg font-bold text-[var(--text-ink)] leading-snug line-clamp-2 mb-1.5">
            Pinterest Pin Title
          </h3>
          <p id="result-desc" class="text-xs text-[var(--text-mute)] line-clamp-2 mb-4">
            Original source media ready for direct local download.
          </p>

          <!-- Guardrail Notice -->
          <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/50 text-[11px] text-blue-700 dark:text-blue-300 mb-4">
            <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            <span>Original source stream • Max 500 MB limit active</span>
          </div>

          <!-- Format Selection List -->
          <div class="space-y-2.5" id="format-buttons-list">
            <!-- Format items injected via JS -->
          </div>
        </div>

        <!-- Actions Footer -->
        <div class="pt-3 border-t border-[var(--border-color)] flex items-center justify-between">
          <button 
            id="btn-new-download" 
            type="button" 
            class="text-xs font-medium text-[var(--text-mute)] hover:text-[var(--text-ink)] flex items-center gap-1 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Download Another Pin
          </button>

          <a 
            id="result-canonical-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
          >
            <span>View on Pinterest</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
