---
interface Props {
  activePage?: string;
}
import Logo from "./Logo.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const { activePage = "home" } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const authData = Astro.locals.auth();
const isSignedIn = !!authData?.userId;

const getUrl = (path: string) => {
  return currentLang === "en"
    ? path
    : `/${currentLang}${path === "/" ? "" : path}`;
};
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border-color)] bg-[var(--bg-canvas)]/80 backdrop-blur-md transition-colors"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <a href={getUrl("/")} class="flex items-center gap-2.5 group">
      <div
        class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-base shadow-sm group-hover:scale-105 transition-transform overflow-hidden"
      >
        <Logo class="w-full h-full object-contain" />
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-lg tracking-tight text-[var(--text-ink)]"
          >mediasavee</span
        >
        <span
          class="tech-badge px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 font-semibold border border-neutral-200 dark:border-neutral-700"
          >AI</span
        >
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-1 text-sm font-medium text-[var(--text-body)]"
    >
      <a
        href={getUrl("/")}
        class={`px-3 py-1.5 rounded-md transition-colors hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] ${activePage === "home" ? "text-[var(--text-ink)] font-semibold bg-[var(--bg-surface-secondary)]" : ""}`}
      >
        {t("nav.home")}
      </a>
      <a
        href={getUrl("/video-downloader")}
        class={`px-3 py-1.5 rounded-md transition-colors hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] ${activePage === "video" ? "text-[var(--text-ink)] font-semibold bg-[var(--bg-surface-secondary)]" : ""}`}
      >
        {t("nav.video")}
      </a>
      <a
        href={getUrl("/image-downloader")}
        class={`px-3 py-1.5 rounded-md transition-colors hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] ${activePage === "image" ? "text-[var(--text-ink)] font-semibold bg-[var(--bg-surface-secondary)]" : ""}`}
      >
        {t("nav.photo")}
      </a>
      <a
        href={getUrl("/gif-downloader")}
        class={`px-3 py-1.5 rounded-md transition-colors hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] ${activePage === "gif" ? "text-[var(--text-ink)] font-semibold bg-[var(--bg-surface-secondary)]" : ""}`}
      >
        {t("nav.gif")}
      </a>
      <a
        href={getUrl("/audio-extractor")}
        class={`px-3 py-1.5 rounded-md transition-colors hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] ${activePage === "audio" ? "text-[var(--text-ink)] font-semibold bg-[var(--bg-surface-secondary)]" : ""}`}
      >
        {t("nav.audio")}
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguagePicker />
      <!-- Dark/Light Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="p-2 rounded-full text-[var(--text-mute)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)] transition-colors"
      >
        <!-- Sun icon (for dark mode) -->
        <svg
          id="theme-sun"
          class="w-4 h-4 hidden dark:block"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg
          id="theme-moon"
          class="w-4 h-4 block dark:hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      {!isSignedIn ? (
        <a
          href="/sign-in"
          class="hidden sm:inline-flex btn-pill-primary text-xs"
        >
          <span>Sign In</span>
        </a>
      ) : (
        <div class="relative" id="user-menu-wrapper">
          <button
            id="user-menu-btn"
            type="button"
            aria-label="User menu"
            class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-violet-600 flex items-center justify-center text-white text-xs font-bold shadow-md hover:scale-105 transition-transform"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </button>
          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-44 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xl py-1 z-50"
          >
            <a href="/sign-in" class="block px-4 py-2 text-xs text-[var(--text-body)] hover:bg-[var(--bg-surface-secondary)]">My Account</a>
            <div class="border-t border-[var(--border-color)] my-1"></div>
            <button id="sign-out-btn" class="w-full text-left block px-4 py-2 text-xs text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30">Sign Out</button>
          </div>
        </div>
      )}

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open mobile menu"
        class="md:hidden p-2 rounded-lg text-[var(--text-mute)] hover:text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)]"
      >
        <svg
          class="w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-[var(--border-color)] bg-[var(--bg-surface)] px-4 pt-2 pb-4 space-y-1"
  >
    <a
      href={getUrl("/")}
      class="block px-3 py-2 rounded-md text-base font-medium text-[var(--text-ink)] hover:bg-[var(--bg-surface-secondary)]"
      >{t("nav.home")}</a
    >
    <a
      href={getUrl("/video-downloader")}
      class="block px-3 py-2 rounded-md text-base font-medium text-[var(--text-body)] hover:bg-[var(--bg-surface-secondary)]"
      >{t("nav.video")}</a
    >
    <a
      href={getUrl("/image-downloader")}
      class="block px-3 py-2 rounded-md text-base font-medium text-[var(--text-body)] hover:bg-[var(--bg-surface-secondary)]"
      >{t("nav.photo")}</a
    >
    <a
      href={getUrl("/gif-downloader")}
      class="block px-3 py-2 rounded-md text-base font-medium text-[var(--text-body)] hover:bg-[var(--bg-surface-secondary)]"
      >{t("nav.gif")}</a
    >
    <a
      href={getUrl("/audio-extractor")}
      class="block px-3 py-2 rounded-md text-base font-medium text-[var(--text-body)] hover:bg-[var(--bg-surface-secondary)]"
      >{t("nav.audio")}</a
    >

    <div class="pt-2">
      {!isSignedIn ? (
        <a href="/sign-in" class="w-full btn-pill-primary text-sm py-2 flex items-center justify-center gap-2">
          Sign In
        </a>
      ) : (
        <button id="sign-out-btn-mobile" class="w-full btn-pill-primary text-sm py-2 bg-red-600 hover:bg-red-700">Sign Out</button>
      )}
    </div>
  </div>
</header>

<script is:inline>
  // Theme Toggle Handler
  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  // Mobile Menu Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // User dropdown menu toggle
  const userMenuBtn = document.getElementById('user-menu-btn');
  const userMenuDropdown = document.getElementById('user-menu-dropdown');
  if (userMenuBtn && userMenuDropdown) {
    userMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      userMenuDropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', () => {
      userMenuDropdown.classList.add('hidden');
    });
  }

  // Sign-out handlers (desktop + mobile)
  async function handleSignOut() {
    try {
      await window.Clerk?.signOut();
      window.location.href = '/';
    } catch (e) {
      window.location.href = '/sign-in';
    }
  }

  const signOutBtn = document.getElementById('sign-out-btn');
  if (signOutBtn) signOutBtn.addEventListener('click', handleSignOut);

  const signOutBtnMobile = document.getElementById('sign-out-btn-mobile');
  if (signOutBtnMobile) signOutBtnMobile.addEventListener('click', handleSignOut);
</script>
