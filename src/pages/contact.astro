---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<Layout 
  title="Contact Us — mediasavee AI"
  description="Get in touch with the mediasavee AI team for customer support, Pro account inquiries, API access, or DMCA compliance."
  canonicalUrl="https://mediasavee.com/contact"
>
  <Navbar activePage="contact" />

  <main class="flex-1 py-16 px-4 sm:px-6 max-w-4xl mx-auto w-full">
    <!-- Header Section -->
    <div class="border-b border-[var(--border-color)] pb-8 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-mono font-medium mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>SUPPORT & INQUIRIES • AVERAGE RESPONSE &lt; 24H</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--text-ink)] tracking-tight mb-4">
        Contact Our Engineering & Support Team
      </h1>
      <p class="text-base sm:text-lg text-[var(--text-body)] leading-relaxed max-w-2xl">
        Have a question about downloading a specific pin format, want to partner with us, or need assistance with your Pro subscription? We are here to help.
      </p>
    </div>

    <!-- Contact Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- Channel 1: Customer Support -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-[var(--text-ink)] mb-1">Customer & Tech Support</h2>
          <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">
            Trouble with a download, URL parsing errors, or questions about the 500 MB limit.
          </p>
        </div>
        <a 
          href="mailto:support@mediasavee.com" 
          class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1.5"
        >
          <span>support@mediasavee.com</span>
          <span>→</span>
        </a>
      </div>

      <!-- Channel 2: Business & API -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-[var(--text-ink)] mb-1">Business & Advertising</h2>
          <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">
            Sponsorship opportunities, high-volume batch API licensing, and publisher inquiries.
          </p>
        </div>
        <a 
          href="mailto:business@mediasavee.com" 
          class="font-mono text-xs font-semibold text-purple-600 dark:text-purple-400 hover:underline flex items-center gap-1.5"
        >
          <span>business@mediasavee.com</span>
          <span>→</span>
        </a>
      </div>

      <!-- Channel 3: Legal & DMCA -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-[var(--text-ink)] mb-1">Legal & DMCA Notices</h2>
          <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">
            Copyright infringement reports, takedown inquiries, and privacy compliance requests.
          </p>
        </div>
        <a 
          href="mailto:legal@mediasavee.com" 
          class="font-mono text-xs font-semibold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1.5"
        >
          <span>legal@mediasavee.com</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Quick Troubleshooting FAQ -->
    <div class="space-y-6 text-sm text-[var(--text-body)] leading-relaxed">
      <h2 class="text-xl font-bold text-[var(--text-ink)]">Frequently Asked Support Questions</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)]">
          <h3 class="font-semibold text-[var(--text-ink)] mb-1">Why is my Pinterest link failing to resolve?</h3>
          <p class="text-xs text-[var(--text-body)] leading-relaxed">
            Ensure the pin is on a public board and hasn't been removed or set to secret. Links copied directly from the Pinterest mobile app (pin.it) or desktop browser (pinterest.com/pin/...) are fully supported.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)]">
          <h3 class="font-semibold text-[var(--text-ink)] mb-1">Can I get an invoice or VAT receipt for Pro?</h3>
          <p class="text-xs text-[var(--text-body)] leading-relaxed">
            Yes! Automated receipts are emailed upon checkout. If you need a company VAT/GST invoice with custom business details, email our billing team at support@mediasavee.com.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)]">
          <h3 class="font-semibold text-[var(--text-ink)] mb-1">How do I cancel my Pro subscription?</h3>
          <p class="text-xs text-[var(--text-body)] leading-relaxed">
            You can cancel with one click at any time from your checkout confirmation email or by reaching out to support with your registered email address.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)]">
          <h3 class="font-semibold text-[var(--text-ink)] mb-1">What is the 500 MB limit policy?</h3>
          <p class="text-xs text-[var(--text-body)] leading-relaxed">
            Virtually all Pinterest images and video tutorials are between 2 MB and 80 MB. Our 500 MB limit protects server bandwidth so downloads remain blazing fast for everyone.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
