---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  error?: unknown;
}

Astro.response.status = 500;
Astro.response.statusText = 'Internal Server Error';

const { error } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const getUrl = (path: string) => {
  return currentLang === 'en' ? path : `/${currentLang}${path === '/' ? '' : path}`;
};

// Format error details safely
let errorMessage = 'An unexpected server exception occurred.';
let errorStack = '';
if (error instanceof Error) {
  errorMessage = error.message;
  errorStack = error.stack || '';
} else if (typeof error === 'string') {
  errorMessage = error;
}

// Generate a mock telemetry incident ID
const incidentId = 'err_' + Math.random().toString(36).substring(2, 10).toUpperCase();
---

<Layout
  title={`${t('error.500.title')} (500) — mediasavee AI`}
  description={t('error.500.desc')}
  canonicalUrl={`https://mediasavee.com${getUrl('/500')}`}
>
  <Navbar />

  <main class="flex-1 relative flex flex-col items-center justify-center px-4 sm:px-6 py-16 sm:py-24 text-center overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-gradient-to-tr from-rose-500/10 via-amber-500/10 to-purple-500/10 blur-3xl pointer-events-none -z-10 rounded-full"></div>

    <div class="max-w-xl mx-auto flex flex-col items-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-rose-500/20 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-mono font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
        <span>{t('error.500.badge')}</span>
      </div>

      <!-- Large Gradient 500 Display -->
      <div class="relative select-none mb-2">
        <h1 class="text-8xl sm:text-9xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-rose-950 via-rose-700 to-neutral-500 dark:from-white dark:via-rose-200 dark:to-neutral-500 leading-none">
          500
        </h1>
      </div>

      <!-- Headline & Explanatory Subtitle -->
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-ink)] mb-3">
        {t('error.500.title')}
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-body)] max-w-md mx-auto leading-relaxed mb-8">
        {t('error.500.desc')}
      </p>

      <!-- Network / Service Health Status Card -->
      <div class="w-full max-w-md p-3.5 mb-8 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-xs flex items-center justify-between text-left">
        <div class="flex items-center gap-3">
          <div class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </div>
          <div>
            <div class="text-xs font-semibold text-[var(--text-ink)]">{t('error.500.status_label')}</div>
            <div class="text-[11px] text-[var(--text-mute)]">{t('error.500.status_text')}</div>
          </div>
        </div>
        <div class="text-right">
          <span class="tech-badge text-[10px] px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-[var(--border-color)]">
            {incidentId}
          </span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <button onclick="window.location.reload()" class="btn-pill-primary cursor-pointer">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.038 8.038 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>{t('error.500.btn_reload')}</span>
        </button>

        <a href={getUrl('/')} class="btn-pill-secondary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>{t('error.500.btn_home')}</span>
        </a>

        <a href={getUrl('/contact')} class="btn-pill-secondary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          <span>{t('error.500.btn_contact')}</span>
        </a>
      </div>

      <!-- Expandable Diagnostic Telemetry Panel -->
      <details class="w-full max-w-md group border border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)] p-3.5 text-left text-xs transition-all">
        <summary class="cursor-pointer font-mono font-medium text-[var(--text-mute)] hover:text-[var(--text-ink)] flex items-center justify-between select-none">
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-neutral-400 group-open:rotate-90 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
            <span>{t('error.500.diagnostics')}</span>
          </span>
          <span class="text-[10px] text-neutral-400 font-mono">Incident {incidentId}</span>
        </summary>
        <div class="mt-3 pt-3 border-t border-[var(--border-color)] space-y-2 font-mono text-[11px] text-[var(--text-body)] overflow-x-auto">
          <div><span class="text-neutral-400 font-semibold">Status:</span> 500 Internal Server Error</div>
          <div><span class="text-neutral-400 font-semibold">Message:</span> <span class="text-rose-500 font-medium">{errorMessage}</span></div>
          <div><span class="text-neutral-400 font-semibold">Timestamp:</span> {new Date().toISOString()}</div>
          {errorStack && (
            <div class="mt-2">
              <span class="text-neutral-400 font-semibold">Stack Trace:</span>
              <pre class="mt-1 p-2 rounded bg-neutral-900 text-neutral-200 text-[10px] leading-relaxed overflow-x-auto whitespace-pre-wrap">{errorStack}</pre>
            </div>
          )}
        </div>
      </details>
    </div>
  </main>

  <Footer />
</Layout>
