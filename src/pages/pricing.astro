---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PricingTiers from '../components/PricingTiers.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Footer from '../components/Footer.astro';
import ProCheckoutModal from '../components/modals/ProCheckoutModal.astro';
---

<Layout 
  title="Pricing Plans — Free vs Pro Ad-Free Workspace — meadiasavee AI"
  description="Explore Free Starter and Pro Creator plans for meadiasavee AI. Enjoy 100% ad-free downloading, batch URL queues, and priority servers."
  canonicalUrl="https://meadiasavee.com/pricing"
>
  <Navbar activePage="pricing" />

  <main class="flex-1 pt-6">
    <PricingTiers />
    <FaqAccordion />
  </main>

  <Footer />
  <ProCheckoutModal />
</Layout>
